DATABASE_URL="postgresql://keykeep:keykeep@localhost:5432/keykeep?schema=public"
REDIS_URL="redis://localhost:6379"
KEYKEEP_GATEWAY_URL="http://localhost:8080"

# 员工在「我的接口」页看到的网关地址（浏览器可访问的那个域名/端口）。
# 留空时按「当前访问控制台的主机 + GATEWAY_PORT」推断，适合开发机；
# 生产必须显式设置，否则员工会拿到 127.0.0.1。
KEYKEEP_PUBLIC_GATEWAY_URL=""
GATEWAY_PORT="8080"

# 控制台自身的对外地址，用于生成「kkconnect login --server …」里的地址。
# 留空时退回浏览器当前 origin。桌面版开局域网模式时会自动注入本机局域网 IP；
# Compose 部署请显式设置，否则老板在本机用 127.0.0.1 打开页面时，
# 页面上印出来的地址员工连不上。
KEYKEEP_PUBLIC_CONSOLE_URL=""

# FR-11 模型目录发现（models.dev，MIT）。离线部署指向内网镜像；
# 目录与价格落在库里，不写文件缓存。MODEL_CATALOG_REFRESH_HOURS=0 可关定时刷新。
MODEL_CATALOG_SOURCE="https://models.dev/api.json"
MODEL_CATALOG_REFRESH_HOURS="24"
KEYKEEP_KEK="REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES"
SESSION_SECRET="REPLACE_WITH_AT_LEAST_16_RANDOM_CHARS"
KEYKEEP_MASK_MODE="rules-only"
KEYKEEP_LICENSE_PUBLIC_KEY=""
KEYKEEP_MACHINE_CODE=""
KEYKEEP_LICENSE_FILE=""

# ---- 维护平面（FR-60—67；docs/security/security-and-remote-maintenance.md）----
# 默认关闭：全新安装没有任何维护监听或入口（RM-A01）。只有客户显式设为 1/true
# 才允许在控制面内建立维护工单/会话；网关进程不包含维护组件，关闭不影响转发（FR-66）。
KEYKEEP_MAINTENANCE_ENABLED="0"
