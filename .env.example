# KeyKeep 本地环境变量模板
# ---------------------------------------------------------------
# 本文件只含虚构占位符，任何真实凭据都不得写入本文件或本仓库。
# 使用方法：复制为 .env 后逐项替换占位符；.env 已被 .gitignore 排除。
# 配置项来源：基准文档 v2.3 附录 B 表 B-1（配置项参考）。
# ---------------------------------------------------------------

# 凭据加密主密钥（必填）。安装时生成，32 字节随机数的 base64。
# 生成方式（Linux）：openssl rand -base64 32
# 丢失后果：数据库中所有上游凭据密文不可解密，见 v2.3 第 13.7 节。
KEYKEEP_KEK=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES

# 审计事件链密钥（强烈建议填）。配了就按 HMAC-SHA256 入链：只持有数据库
# 写权限的人无法删掉链尾再重算；留空则退化为裸 sha256（能发现改行/删中间行，
# 但挡不住删尾重算）。控制面与网关必须同一个值。
# 生成方式（Linux）：openssl rand -hex 32
# 桌面版由安装程序自动生成并写入 settings.json，不需要手工配置。
KEYKEEP_AUDIT_CHAIN_KEY=

# Postgres 口令（compose 部署必填；docker-compose.yml 不再提供默认值）。
# 生成方式（Linux）：openssl rand -hex 16
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# 控制面会话签名密钥（compose 部署必填；至少 32 个随机字符）。
# 生成方式（Linux）：openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_32_RANDOM_CHARS_MINIMUM

# 首装账号口令（compose 的 migrate 服务在首次迁移后执行 prisma/seed.mjs）。
# 不填也能起来：种子脚本会随机生成并只在交互终端打印一次——但也只在
# 「账号第一次被创建」时写入，所以第二次起栈就再也拿不到那个口令了。
# 想可重复部署就固定写在这里；建好账号后本行可以删掉。
# 管理员口令最少 12 位。
KEYKEEP_SEED_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD_MIN_12_CHARS
KEYKEEP_SEED_USER_PASSWORD=REPLACE_WITH_EMPLOYEE_PASSWORD_MIN_12_CHARS

# 构建期 npm 源（可选）。corepack 拉 pnpm 与 pnpm install 走这个源。
# 国内网络直连 registry.npmjs.org 会长时间挂住（实测 >25 分钟），改成镜像源可显著加速。
COREPACK_NPM_REGISTRY=https://registry.npmmirror.com

# 网关构建期：Go 模块代理与 distroless 基础镜像（留空 = 官方源）。
# 国内网络直连 proxy.golang.org / gcr.io 会 TLS 握手超时（实测），此时改成：
#   GOPROXY=https://goproxy.cn,direct
#   GATEWAY_BASE_IMAGE=docker.m.daocloud.io/gcr.io/distroless/static-debian12:nonroot
# 换底座时要求镜像里仍有 nonroot 用户（Dockerfile 末尾 USER nonroot:nonroot）。
GOPROXY=
GATEWAY_BASE_IMAGE=

# 会话 cookie 的 Secure 标志（compose 默认 false）。
# 只有控制面跑在 TLS 后面时才改成 true：浏览器不会把 Secure cookie 回传到 http://，
# 内网直连 http://<IP>:8443 时设成 true 会表现为「登录成功但一刷新就退出」。
KEYKEEP_COOKIE_SECURE=false

# 是否允许上游地址落在私网段（默认 false = 拒绝，防 SSRF）。
# 只有一种情况该开：上游是内网自建中转（vLLM / one-api / LiteLLM 之类），
# 或你正在跟着 README 的「本地五分钟跑通」用栈内 mock 上游。
# 接公网官方 API（api.openai.com 等）时必须保持 false。
KEYKEEP_ALLOW_PRIVATE_UPSTREAMS=false

# 控制台对外访问地址，用于生成邀请链接。
PUBLIC_BASE_URL=http://localhost:3000

# 时区，影响报表日界。
TZ=Asia/Shanghai

# 数据面与控制面端口。
GATEWAY_PORT=8080
WEB_PORT=3000

# 员工「我的接口」页展示的地址（可选）。
# 不填时按浏览器当前主机 + GATEWAY_PORT 推断；员工在别的机器上访问时，
# 必须填成他们能连到的地址，否则页面给的 Base URL 会是 127.0.0.1。
KEYKEEP_PUBLIC_GATEWAY_URL=
KEYKEEP_PUBLIC_CONSOLE_URL=

# M6 脱敏（ADR-008）。rules-only 离线可用；block 需要本地检测器 URL。
KEYKEEP_MASK_MODE=rules-only
KEYKEEP_MASK_MODEL_URL=
KEYKEEP_MASK_WATCH_INTERVAL=2s

# FR-35 离线授权。公钥为 SPKI DER 的 base64；机器码由安装器在宿主机计算。
KEYKEEP_LICENSE_PUBLIC_KEY=
KEYKEEP_MACHINE_CODE=
KEYKEEP_LICENSE_FILE=

# 数据库（PostgreSQL 16）。示例中的用户名与口令均为占位符。
DATABASE_URL=postgresql://keykeep:REPLACE_DB_PASSWORD@localhost:5432/keykeep

# 没有 Redis：限流、预算、幂等与并发闸门全部走 PostgreSQL 或进程内存。

# 并发与限流默认值，取自表 B-1，按需覆盖。
GATEWAY_MAX_CONCURRENCY=200
CREDENTIAL_MAX_CONCURRENCY=10
QUEUE_PER_CREDENTIAL=100
QUEUE_TIMEOUT_SECONDS=10

# 上游超时（秒）。
UPSTREAM_CONNECT_TIMEOUT=10
UPSTREAM_FIRST_BYTE_TIMEOUT=60
UPSTREAM_TOTAL_TIMEOUT=600
MAX_RETRIES=3

# 上游凭据示例位：仅用于本地 Mock，禁止填入真实 Key。
# 阶段 0 原型只连本地 Mock 上游，见 docs/prototypes/README.md。
UPSTREAM_MOCK_BASE_URL=http://127.0.0.1:18080
UPSTREAM_MOCK_API_KEY=sk-mock-fixture-not-a-real-key
